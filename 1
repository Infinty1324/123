<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI科普智能体侧边栏</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft YaHei", sans-serif;
        }
        body {
            background-color: #f0f4f9;
            display: flex;
            justify-content: flex-end;
            padding: 20px;
        }
        /* 侧边栏容器 */
        .sidebar {
            width: 240px;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            padding: 16px;
        }
        /* 顶部Banner */
        .banner {
            width: 100%;
            height: 120px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 8px;
            margin-bottom: 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
        }
        .banner h2 {
            font-size: 18px;
            margin-bottom: 4px;
        }
        .banner p {
            font-size: 14px;
            opacity: 0.9;
        }
        /* 模块标题 */
        .module-title {
            font-size: 15px;
            font-weight: bold;
            color: #333;
            margin: 16px 0 12px;
        }
        /* 常见应用网格 */
        .app-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 16px;
        }
        .app-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }
        .app-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 18px;
        }
        .app-name {
            font-size: 12px;
            color: #666;
        }
        /* 活动推荐 */
        .activity-list {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
        }
        .activity-item {
            flex: 1;
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
        }
        .activity-item img {
            width: 100%;
            height: 80px;
            object-fit: cover;
        }
        .activity-item p {
            font-size: 12px;
            color: #333;
            padding: 6px 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        /* 图书推荐 */
        .book-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }
        .book-item {
            cursor: pointer;
        }
        .book-item img {
            width: 100%;
            height: 100px;
            border-radius: 6px;
            object-fit: cover;
        }
        .book-item p {
            font-size: 12px;
            color: #666;
            text-align: center;
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <!-- 顶部Banner -->
        <div class="banner">
            <h2>AI科普智能挑战</h2>
            <p>探索AI世界，趣味问答闯关</p>
        </div>

        <!-- 常见应用 -->
        <div class="module-title">常见应用</div>
        <div class="app-grid">
            <div class="app-item">
                <div class="app-icon" style="background-color: #ff6b6b;">🎯</div>
                <div class="app-name">趣味问答</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #4ecdc4;">📚</div>
                <div class="app-name">错题记忆</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #ffe66d;">📊</div>
                <div class="app-name">知识点图谱</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #a8dadc;">🏆</div>
                <div class="app-name">学习打卡</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #ff9f1c;">🎬</div>
                <div class="app-name">科普视频</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #2ec4b6;">🧠</div>
                <div class="app-name">AI小课堂</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #e71d36;">📖</div>
                <div class="app-name">科普文章</div>
            </div>
            <div class="app-item">
                <div class="app-icon" style="background-color: #00a6fb;">💬</div>
                <div class="app-name">智能答疑</div>
            </div>
        </div>

        <!-- 活动推荐 -->
        <div class="module-title">活动推荐</div>
        <div class="activity-list">
            <div class="activity-item">
                <img src="https://picsum.photos/200/120?random=1" alt="AI科普闯关">
                <p>AI科普闯关活动</p>
            </div>
            <div class="activity-item">
                <img src="https://picsum.photos/200/120?random=2" alt="AI知识竞赛">
                <p>AI知识竞赛报名</p>
            </div>
        </div>

        <!-- 科普资源推荐 -->
        <div class="module-title">科普资源推荐</div>
        <div class="book-grid">
            <div class="book-item">
                <img src="https://picsum.photos/100/120?random=3" alt="AI入门">
                <p>AI入门指南</p>
            </div>
            <div class="book-item">
                <img src="https://picsum.photos/100/120?random=4" alt="机器学习">
                <p>机器学习基础</p>
            </div>
            <div class="book-item">
                <img src="https://picsum.photos/100/120?random=5" alt="深度学习">
                <p>深度学习入门</p>
            </div>
        </div>
    </div>
</body>
</html>
